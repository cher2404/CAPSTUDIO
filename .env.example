# --- Website ---
NEXT_PUBLIC_SITE_URL=https://capmediastudio.nl
NEXT_PUBLIC_CONTACT_EMAIL=hallo@capmediastudio.nl
NEXT_PUBLIC_INSTAGRAM=capmediastudio
NEXT_PUBLIC_KVK=12345678
NEXT_PUBLIC_BTW=

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# --- E-mail via Resend ---
RESEND_API_KEY=re_...
EMAIL_FROM="CAP Media Studio <hallo@capmediastudio.nl>"
# Hier komen meldingen van nieuwe aanvragen, berichten en boekingen binnen. Dit adres is ook het admin-account.
ADMIN_EMAIL=hallo@capmediastudio.nl

# --- Herinneringen (Vercel Cron) ---
CRON_SECRET=een-lange-willekeurige-string
# Dagelijkse cron: 36 (standaard). Uurlijkse cron (Vercel Pro of pg_cron): 24
REMINDER_WINDOW_HOURS=36

# --- Optioneel: Google Calendar ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
